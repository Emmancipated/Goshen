# Email service for the contact form (https://resend.com)
RESEND_API_KEY=
# Optional: verified sender. Leave empty to use Resend's sandbox (onboarding@resend.dev).
CONTACT_FROM_EMAIL=

# Bank transfer details shown on the Donate page (public, safe to expose)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# Paystack public key (pk_live_...) to enable online card donations
NEXT_PUBLIC_PAYSTACK_KEY=

# Optional: URL of the Founder's message video (mp4/webm). When empty, a placeholder shows in the lightbox.
NEXT_PUBLIC_FOUNDER_VIDEO=
